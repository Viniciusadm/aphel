    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-table": "^9.3.1",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "i18next": "^26.5.3",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^1.59.0",
    "micromark": "^4.0.3",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
