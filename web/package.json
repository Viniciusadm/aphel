{
  "name": "web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run docs:build",
    "lint": "oxlint && node scripts/check-module-texts.mjs",
    "typecheck": "tsc -b --noEmit",
    "api:types": "node scripts/generate-api-types.mjs",
    "i18n:types": "node scripts/i18n-types/index.mjs",
    "preview": "vite preview",
    "docs:dev": "astro dev --root docs --port 4321",
    "docs:build": "astro build --root docs"
  },
  "dependencies": {
