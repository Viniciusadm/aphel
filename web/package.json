    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "astro": "^7.4.7",
    "oxlint": "^1.88.0",
    "starlight-links-validator": "^0.27.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
