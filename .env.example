# Único .env do Aphel: copie para .env na raiz do repositório e ajuste.
# Vale para o desenvolvimento (o binário procura o .env na pasta atual e nas
# de cima, então `cargo run` em back/ acha este arquivo), para o binário em
# produção e para o Docker Compose (docker-compose.yml, docker-compose.prod.yml e docker/demo).
# Referência completa: docs/configuration.md
#
# O .env só guarda o que o servidor precisa antes de existir banco, o que o
# protege e o que afina o processo. Endereço público, e-mail de envio (SMTP),
# armazenamento de arquivos, limite de upload, webhooks, limites de tokens de
# API e catálogo são configurados na tela (Configurações), depois do instalador.

# Endereço HTTP do servidor. No Docker o compose fixa 0.0.0.0:3001 dentro do
# contêiner; a porta publicada no host é APP_PORT.
HTTP_HOST=127.0.0.1
HTTP_PORT=3001

# Conexão MySQL. O padrão aponta para o MySQL do `make up`. No Docker o compose
# monta o DATABASE_URL a partir das variáveis MYSQL_* abaixo.
DATABASE_URL=mysql://aphel:aphel@127.0.0.1:3306/aphel

# Várias empresas no mesmo processo (multi-tenancy, ainda indisponível nesta
# versão): troque o DATABASE_URL pelo banco de controle. Os bancos das empresas
# ficam no mesmo servidor MySQL, com as mesmas credenciais.
# CONTROL_DATABASE_URL=mysql://aphel:aphel@127.0.0.1:3306/aphel_control
# CONSOLE_HOST=console.localhost
# TENANT_DATABASE_MAX_CONNECTIONS=10

# Chave de criptografia dos segredos (senha SMTP, chave do S3, webhooks,
# integrações, 2FA e push): 32 bytes em base64. Gere com
# `aphel secrets generate-key` ou `openssl rand -base64 32` e guarde fora do
# backup do banco. Sem ela, salvar segredos falha.
APP_ENCRYPTION_KEY=
# Chaves antigas aceitas durante a rotação (separadas por vírgula).
# APP_ENCRYPTION_PREVIOUS_KEYS=

# Rodar migrations no boot (default: true). Use 0/false para desligar.
RUN_MIGRATIONS=true

# Filtro de logs (tracing). Default: info.
RUST_LOG=info

# Worker de jobs (aphel worker ou aphel serve --with-worker).
# WORKER_CONCURRENCY=4
# WORKER_POLL_INTERVAL_MS=1000
# WORKER_JOB_TIMEOUT_SECS=300
# SCHEDULER_INTERVAL_SECS=5

# Métricas Prometheus em /metrics (desligadas sem token) e limites do /health/ready.
# METRICS_TOKEN=
# HEALTH_REQUIRE_WORKER=true
# HEALTH_QUEUE_MAX_DELAY_SECS=300

# Espaço livre mínimo exigido pelo aphel upgrade.
# UPGRADE_MIN_FREE_DISK_MB=1024

# Webhooks para endereços de rede privada/loopback (proteção contra SSRF).
# WEBHOOKS_ALLOW_PRIVATE_NETWORKS=false

# Docker Compose (docker-compose.yml, docker-compose.prod.yml e docker/demo). Ignoradas pelo
# binário. Evite caracteres especiais de URL (@ : / ? # %) na senha, porque ela
# entra no DATABASE_URL.
# Imagem usada pelo docker-compose.prod.yml. Fixe a versão em produção (ex.: :0.2.0).
# APHEL_IMAGE=ghcr.io/viniciusadm/aphel:latest
APP_PORT=3001
MYSQL_DATABASE=aphel
MYSQL_USER=aphel
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# Modo demonstração (sem e-mails, banner e ações de conta bloqueadas). O
# compose da demo já liga DEMO_MODE. Horário do reset em UTC.
# DEMO_MODE=false
# DEMO_USER_EMAIL=demo@aphel.demo
# DEMO_USER_PASSWORD=aphel-demo
# DEMO_RESET_TIME=03:00
