{
  "format": "aphel-theme",
  "format_version": 1,
  "id": "aphel.slate",
  "name": "Slate",
  "version": "1.0.0",
  "author": "Aphel",
  "description": "Visual sóbrio e arredondado: botões em pílula, cartões sem sombra e azul-ardósia como cor principal.",
  "license": "AGPL-3.0-or-later",
  "min_aphel_version": "0.1.0",
  "tokens": {
    "shared": {
      "radius": "0.5rem",
      "button-radius": "9999px",
      "input-radius": "0.5rem",
      "card-radius": "0.75rem",
      "popover-radius": "0.625rem",
      "dialog-radius": "0.75rem",
      "badge-radius": "9999px",
      "card-shadow": "none",
      "control-height-sm": "2.25rem",
      "control-height-md": "2.5rem",
      "control-height-lg": "2.75rem",
      "font-family-sans": {
        "families": [
          "Inter",
          "Segoe UI"
        ],
        "fallback": "sans-serif"
      }
    },
    "light": {
      "background": "oklch(0.985 0.004 250)",
      "foreground": "oklch(0.22 0.03 255)",
      "card": "oklch(1 0 0)",
      "card-foreground": "oklch(0.22 0.03 255)",
      "primary": "oklch(0.44 0.11 250)",
      "primary-solid": "oklch(0.44 0.11 250)",
      "secondary": "oklch(0.95 0.012 250)",
      "secondary-foreground": "oklch(0.28 0.04 255)",
      "muted": "oklch(0.95 0.012 250)",
      "muted-foreground": "oklch(0.5 0.03 255)",
      "accent": "oklch(0.93 0.025 250)",
      "accent-foreground": "oklch(0.28 0.04 255)",
      "border": "oklch(0.9 0.015 250)",
      "input": "oklch(0.64 0.025 250)",
      "sidebar": "oklch(0.97 0.008 250)",
      "sidebar-accent": "oklch(0.92 0.02 250)",
      "sidebar-border": "oklch(0.9 0.015 250)"
    },
    "dark": {}
  },
  "fonts": []
}
