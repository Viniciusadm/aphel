{
  "format": "aphel-config",
  "format_version": 1,
  "min_aphel_version": "0.1.0",
  "id": "aphel.saas.en",
  "version": "1.0.0",
  "name": "SaaS",
  "description": "For subscription software companies: from trial to closed subscription, with plan, MRR, number of seats, trial end and renewal date.",
  "author": "Aphel",
  "locale": "en",
  "sections": {
    "fields": [
      {
        "record_type": "deal",
        "key": "plan",
        "label": "Plan",
        "type": "select",
        "options": [
          {
            "value": "starter",
            "label": "Starter",
            "color": "#6e7781"
          },
          {
            "value": "pro",
            "label": "Pro",
            "color": "#1f6feb"
          },
          {
            "value": "business",
            "label": "Business",
            "color": "#8250df"
          },
          {
            "value": "enterprise",
            "label": "Enterprise",
            "color": "#cf222e"
          }
        ]
      },
      {
        "record_type": "deal",
        "key": "billing_cycle",
        "label": "Billing cycle",
        "type": "select",
        "options": [
          {
            "value": "monthly",
            "label": "Monthly",
            "color": "#1f6feb"
          },
          {
            "value": "yearly",
            "label": "Annual",
            "color": "#1a7f37"
          }
        ]
      },
      {
        "record_type": "deal",
        "key": "mrr",
        "label": "MRR",
        "type": "currency"
      },
      {
        "record_type": "deal",
        "key": "seats",
        "label": "Number of seats",
        "type": "number",
        "config": {
          "min": 1,
          "decimals": 0
        }
      },
      {
        "record_type": "deal",
        "key": "trial_ends_on",
        "label": "Trial end date",
        "type": "date"
      },
      {
        "record_type": "deal",
        "key": "renewal_date",
        "label": "Renewal date",
        "type": "date"
      },
      {
        "record_type": "deal",
        "key": "trial_engagement",
        "label": "Trial engagement",
        "type": "select",
        "options": [
          {
            "value": "high",
            "label": "High",
            "color": "#1a7f37"
          },
          {
            "value": "medium",
            "label": "Medium",
            "color": "#bf8700"
          },
          {
            "value": "low",
            "label": "Low",
            "color": "#cf222e"
          }
        ]
      },
      {
        "record_type": "company",
        "key": "customer_stage",
        "label": "Customer stage",
        "type": "select",
        "options": [
          {
            "value": "trial",
            "label": "In trial",
            "color": "#bf8700"
          },
          {
            "value": "customer",
            "label": "Customer",
            "color": "#1a7f37"
          },
          {
            "value": "churned",
            "label": "Churned",
            "color": "#cf222e"
          }
        ]
      },
      {
        "record_type": "company",
        "key": "current_tool",
        "label": "Current tool",
        "type": "text"
      },
      {
        "record_type": "company",
        "key": "use_case",
        "label": "Primary use case",
        "type": "text"
      }
    ],
    "pipelines": [
      {
        "key": "assinaturas",
        "name": "Subscriptions",
        "default": true,
        "stages": [
          {
            "key": "prospeccao",
            "name": "Trial",
            "kind": "open",
            "probability": 15,
            "exit_required_fields": [
              "trial_ends_on"
            ]
          },
          {
            "key": "qualificacao",
            "name": "Demo",
            "kind": "open",
            "probability": 35
          },
          {
            "key": "proposta",
            "name": "Proposal",
            "kind": "open",
            "probability": 60,
            "entry_required_fields": [
              "plan",
              "seats",
              "mrr"
            ]
          },
          {
            "key": "negociacao",
            "name": "Negotiation",
            "kind": "open",
            "probability": 80
          },
          {
            "key": "ganho",
            "name": "Closed won",
            "kind": "won",
            "probability": 100,
            "entry_required_fields": [
              "plan",
              "mrr",
              "renewal_date"
            ]
          },
          {
            "key": "perdido",
            "name": "Lost",
            "kind": "lost",
            "probability": 0
          }
        ]
      }
    ],
    "lost_reasons": [
      {
        "key": "preco",
        "name": "Price"
      },
      {
        "key": "escolheu_um_concorrente",
        "name": "Chose a competitor"
      },
      {
        "key": "sem_orcamento",
        "name": "No budget"
      },
      {
        "key": "sem_resposta",
        "name": "No response"
      },
      {
        "key": "momento_inadequado",
        "name": "Bad timing"
      },
      {
        "key": "outro",
        "name": "Other"
      },
      {
        "key": "nao_usou_o_trial",
        "name": "Didn't use the trial"
      },
      {
        "key": "faltou_funcionalidade",
        "name": "Missing feature"
      },
      {
        "key": "faltou_integracao",
        "name": "Missing integration"
      }
    ],
    "activity_types": [
      {
        "key": "demo",
        "name": "Demo",
        "icon": "video",
        "color": "#8250df"
      },
      {
        "key": "onboarding",
        "name": "Onboarding",
        "icon": "flag",
        "color": "#1a7f37"
      }
    ],
    "layouts": [
      {
        "record_type": "deal",
        "context": "create",
        "layout": {
          "tabs": [
            {
              "id": "main",
              "label": "Details",
              "sections": [
                {
                  "id": "deal",
                  "label": "Deal",
                  "columns": [
                    {
                      "fields": [
                        {
                          "key": "title"
                        },
                        {
                          "key": "company_id"
                        },
                        {
                          "key": "contact_id"
                        }
                      ]
                    },
                    {
                      "fields": [
                        {
                          "key": "owner_id"
                        },
                        {
                          "key": "expected_close_date"
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "subscription",
                  "label": "Subscription",
                  "columns": [
                    {
                      "fields": [
                        {
                          "key": "plan"
                        },
                        {
                          "key": "billing_cycle"
                        },
                        {
                          "key": "seats"
                        }
                      ]
                    },
                    {
                      "fields": [
                        {
                          "key": "mrr"
                        },
                        {
                          "key": "amount"
                        },
                        {
                          "key": "renewal_date",
                          "required_when": {
                            "field": "billing_cycle",
                            "operator": "eq",
                            "value": "yearly"
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "trial",
                  "label": "Trial",
                  "columns": [
                    {
                      "fields": [
                        {
                          "key": "trial_ends_on"
                        }
                      ]
                    },
                    {
                      "fields": [
                        {
                          "key": "trial_engagement"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      {
        "record_type": "deal",
        "context": "edit",
        "layout": {
          "tabs": [
            {
              "id": "main",
              "label": "Details",
              "sections": [
                {
                  "id": "deal",
                  "label": "Deal",
                  "columns": [
                    {
                      "fields": [
                        {
                          "key": "title"
                        },
                        {
                          "key": "company_id"
                        },
                        {
                          "key": "contact_id"
                        }
                      ]
                    },
                    {
                      "fields": [
                        {
                          "key": "owner_id"
                        },
                        {
                          "key": "expected_close_date"
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "subscription",
                  "label": "Subscription",
                  "columns": [
                    {
                      "fields": [
                        {
                          "key": "plan"
                        },
                        {
                          "key": "billing_cycle"
                        },
                        {
                          "key": "seats"
                        }
                      ]
                    },
                    {
                      "fields": [
                        {
                          "key": "mrr"
                        },
                        {
                          "key": "amount"
                        },
                        {
                          "key": "renewal_date",
                          "required_when": {
                            "field": "billing_cycle",
                            "operator": "eq",
                            "value": "yearly"
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "trial",
                  "label": "Trial",
                  "columns": [
                    {
                      "fields": [
                        {
                          "key": "trial_ends_on"
                        }
                      ]
                    },
                    {
                      "fields": [
                        {
                          "key": "trial_engagement"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      {
        "record_type": "company",
        "context": "create",
        "layout": {
          "tabs": [
            {
              "id": "main",
              "label": "Details",
              "sections": [
                {
                  "id": "company",
                  "label": "Company",
                  "columns": [
                    {
                      "fields": [
                        {
                          "key": "name"
                        },
                        {
                          "key": "website"
                        },
                        {
                          "key": "size_range"
                        }
                      ]
                    },
                    {
                      "fields": [
                        {
                          "key": "customer_stage"
                        },
                        {
                          "key": "owner_id"
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "context",
                  "label": "Context",
                  "columns": [
                    {
                      "fields": [
                        {
                          "key": "current_tool"
                        }
                      ]
                    },
                    {
                      "fields": [
                        {
                          "key": "use_case"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      {
        "record_type": "company",
        "context": "edit",
        "layout": {
          "tabs": [
            {
              "id": "main",
              "label": "Details",
              "sections": [
                {
                  "id": "company",
                  "label": "Company",
                  "columns": [
                    {
                      "fields": [
                        {
                          "key": "name"
                        },
                        {
                          "key": "website"
                        },
                        {
                          "key": "size_range"
                        }
                      ]
                    },
                    {
                      "fields": [
                        {
                          "key": "customer_stage"
                        },
                        {
                          "key": "owner_id"
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "context",
                  "label": "Context",
                  "columns": [
                    {
                      "fields": [
                        {
                          "key": "current_tool"
                        }
                      ]
                    },
                    {
                      "fields": [
                        {
                          "key": "use_case"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    ],
    "views": [
      {
        "key": "trials_vencendo",
        "record_type": "deal",
        "name": "Trials ending soon",
        "view_type": "table",
        "filter": {
          "op": "and",
          "conditions": [
            {
              "field": "status",
              "operator": "eq",
              "value": "open"
            },
            {
              "field": "trial_ends_on",
              "operator": "within_next_days",
              "value": 7
            }
          ]
        },
        "sort": [
          {
            "field": "trial_ends_on",
            "direction": "asc"
          }
        ],
        "columns": [
          "title",
          "company_id",
          "plan",
          "trial_engagement",
          "trial_ends_on",
          "owner_id"
        ]
      },
      {
        "key": "renovacoes_proximas",
        "record_type": "deal",
        "name": "Renewals in the next 60 days",
        "view_type": "table",
        "filter": {
          "op": "and",
          "conditions": [
            {
              "field": "status",
              "operator": "eq",
              "value": "won"
            },
            {
              "field": "renewal_date",
              "operator": "within_next_days",
              "value": 60
            }
          ]
        },
        "sort": [
          {
            "field": "renewal_date",
            "direction": "asc"
          }
        ],
        "columns": [
          "title",
          "company_id",
          "plan",
          "mrr",
          "seats",
          "renewal_date"
        ]
      },
      {
        "key": "clientes_ativos",
        "record_type": "company",
        "name": "Active customers",
        "view_type": "table",
        "filter": {
          "field": "customer_stage",
          "operator": "eq",
          "value": "customer"
        },
        "columns": [
          "name",
          "size_range",
          "current_tool",
          "owner_id"
        ]
      }
    ],
    "dashboard": {
      "widgets": [
        {
          "key": "sales_indicators",
          "size": "large"
        },
        {
          "key": "deals_by_stage",
          "size": "large",
          "settings": {
            "pipeline": "assinaturas"
          }
        },
        {
          "key": "report_totals",
          "size": "medium"
        },
        {
          "key": "pending_center",
          "size": "medium"
        },
        {
          "key": "recent_activity",
          "size": "medium"
        }
      ],
      "period": "month"
    }
  }
}
