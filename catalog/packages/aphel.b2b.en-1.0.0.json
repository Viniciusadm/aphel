            "color": "#1f6feb"
          },
          {
            "value": "up_to_30m",
            "label": "4.8M to 30M",
            "color": "#0f766e"
          },
          {
            "value": "up_to_300m",
            "label": "30M to 300M",
            "color": "#8250df"
          },
          {
            "value": "above_300m",
            "label": "Over 300M",
            "color": "#1a7f37"
          }
        ]
      },
