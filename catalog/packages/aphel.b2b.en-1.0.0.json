            "label": "Technical evaluator",
            "color": "#1f6feb"
          },
          {
            "value": "finance",
            "label": "Finance/procurement",
            "color": "#8250df"
          },
          {
            "value": "user",
            "label": "End user",
            "color": "#6e7781"
          }
        ]
      },
      {
        "record_type": "deal",
        "key": "deal_type",
        "label": "Deal type",
        "type": "select",
        "options": [
          {
            "value": "new_business",
            "label": "New business",
            "color": "#1f6feb"
          },
          {
            "value": "expansion",
            "label": "Expansion",
            "color": "#1a7f37"
          },
          {
            "value": "renewal",
            "label": "Renewal",
            "color": "#8250df"
          }
        ]
      },
      {
        "record_type": "deal",
        "key": "decision_maker_confirmed",
        "label": "Decision maker identified",
        "type": "checkbox"
      },
      {
        "record_type": "deal",
        "key": "competitors",
        "label": "Competitors involved",
        "type": "text"
      },
      {
        "record_type": "deal",
        "key": "next_step",
        "label": "Next step",
        "type": "text"
      },
      {
        "record_type": "deal",
        "key": "demo_date",
        "label": "Demo date",
        "type": "date"
      }
    ],
    "workflow": [
      {
        "key": "vendas_b2b",
        "name": "B2B Sales",
        "default": true,
        "stages": [
          {
            "key": "prospeccao",
            "name": "Prospecting",
            "kind": "open",
            "probability": 10
          },
          {
            "key": "qualificacao",
            "name": "Qualification",
            "kind": "open",
            "probability": 20,
            "exit_required_fields": [
              "company_id",
              "contact_id"
            ]
          },
          {
            "key": "demonstracao",
            "name": "Demo",
            "kind": "open",
            "probability": 35
          },
          {
            "key": "proposta",
            "name": "Proposal",
            "kind": "open",
            "probability": 50,
            "entry_required_fields": [
              "amount",
              "expected_close_date"
            ]
          },
          {
            "key": "negociacao",
            "name": "Negotiation",
            "kind": "open",
            "probability": 75,
            "entry_required_fields": [
              "amount"
            ]
          },
          {
            "key": "ganho",
            "name": "Won",
            "kind": "won",
            "probability": 100
          },
          {
            "key": "perdido",
            "name": "Lost",
            "kind": "lost",
            "probability": 0
          }
        ]
      }
    ],
    "lost_reasons": [
      {
        "key": "preco",
        "name": "Price"
      },
