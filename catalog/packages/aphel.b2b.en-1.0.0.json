        "options": [
          {
            "value": "decision_maker",
            "label": "Decision maker",
            "color": "#cf222e"
          },
          {
            "value": "influencer",
            "label": "Influencer",
            "color": "#d1631a"
          },
          {
            "value": "champion",
            "label": "Champion",
