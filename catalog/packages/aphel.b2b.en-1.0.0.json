{
  "format": "aphel-config",
  "format_version": 1,
  "min_aphel_version": "0.1.0",
  "id": "aphel.b2b.en",
  "version": "1.0.0",
  "name": "B2B Sales",
  "description": "Consultative pipeline for selling to other businesses: qualification, demo, proposal and negotiation, with account industry, size and revenue, plus conversion metrics.",
  "author": "Aphel",
  "locale": "en",
  "sections": {
    "fields": [
      {
        "record_type": "company",
        "key": "sector",
        "label": "Industry",
