{
  "format": "aphel-config",
  "format_version": 1,
  "min_aphel_version": "0.1.0",
  "id": "aphel.freelancer.en",
  "version": "1.1.0",
  "name": "Freelancer",
  "description": "A lean pipeline for solo professionals: from first contact to approved quote, with hourly rate, estimated hours, delivery deadline and payment terms.",
  "author": "Aphel",
  "locale": "en",
  "sections": {
    "fields": [
      {
        "record_type": "deal",
        "key": "pricing_model",
        "label": "Pricing model",
        "type": "select",
        "options": [
          {
            "value": "fixed",
            "label": "Fixed price",
            "color": "#1f6feb"
          },
          {
            "value": "hourly",
            "label": "Hourly",
            "color": "#bf8700"
          }
        ]
      },
      {
        "record_type": "deal",
        "key": "hourly_rate",
        "label": "Hourly rate",
        "type": "currency"
      },
      {
        "record_type": "deal",
        "key": "estimated_hours",
        "label": "Estimated hours",
        "type": "number",
        "config": {
          "min": 0,
          "decimals": 1
        }
      },
      {
        "record_type": "deal",
        "key": "deadline",
        "label": "Delivery deadline",
        "type": "date"
      },
      {
        "record_type": "deal",
        "key": "payment_terms",
        "label": "Payment terms",
        "type": "select",
        "options": [
          {
            "value": "upfront",
            "label": "Paid upfront",
            "color": "#1a7f37"
          },
          {
            "value": "half_half",
            "label": "50% upfront, 50% on delivery",
            "color": "#1f6feb"
          },
          {
            "value": "installments",
            "label": "Installments",
            "color": "#8250df"
          },
          {
            "value": "monthly",
            "label": "Monthly",
            "color": "#0f766e"
          }
        ]
      },
      {
        "record_type": "deal",
        "key": "deliverables",
        "label": "Deliverables",
        "type": "long_text"
      },
      {
        "record_type": "contact",
        "key": "portfolio_source",
        "label": "How they found me",
        "type": "select",
        "options": [
          {
            "value": "referral",
            "label": "Referral",
            "color": "#1a7f37"
          },
          {
            "value": "social_media",
            "label": "Social media",
            "color": "#bf3989"
          },
          {
            "value": "marketplace",
            "label": "Freelance marketplace",
            "color": "#d1631a"
          },
          {
            "value": "website",
            "label": "Website/portfolio",
            "color": "#1f6feb"
          },
          {
            "value": "returning",
            "label": "Returning client",
            "color": "#8250df"
          }
        ]
      }
    ],
    "workflow": [
      {
        "key": "projetos",
        "name": "Projects",
        "default": true,
        "stages": [
          {
            "key": "prospeccao",
            "name": "New contact",
            "kind": "open",
            "probability": 10
          },
          {
            "key": "qualificacao",
            "name": "Briefing",
            "kind": "open",
            "probability": 30
          },
          {
            "key": "proposta",
            "name": "Quote sent",
            "kind": "open",
            "probability": 50,
            "entry_required_fields": [
              "amount",
              "deadline"
            ]
          },
          {
            "key": "negociacao",
            "name": "Awaiting approval",
            "kind": "open",
            "probability": 75
          },
          {
            "key": "ganho",
            "name": "Won",
            "kind": "won",
            "probability": 100
          },
          {
            "key": "perdido",
            "name": "Lost",
            "kind": "lost",
            "probability": 0
          }
        ]
      }
    ],
    "lost_reasons": [
      {
        "key": "preco",
        "name": "Price"
      },
      {
        "key": "escolheu_um_concorrente",
        "name": "Chose a competitor"
      },
      {
        "key": "sem_orcamento",
        "name": "No budget"
      },
      {
        "key": "sem_resposta",
        "name": "No response"
      },
      {
        "key": "momento_inadequado",
        "name": "Bad timing"
      },
      {
        "key": "outro",
        "name": "Other"
      },
      {
        "key": "prazo_incompativel",
        "name": "Deadline conflicts with my schedule"
      }
    ],
    "task_types": [
      {
        "key": "follow_up",
        "name": "Follow-up",
        "icon": "repeat",
        "color": "#0f766e"
      },
      {
        "key": "delivery",
        "name": "Delivery",
        "icon": "send",
        "color": "#1a7f37"
      }
    ],
    "layouts": [
      {
        "record_type": "deal",
        "context": "create",
        "layout": {
          "tabs": [
            {
              "id": "main",
              "label": "Details",
              "sections": [
                {
                  "id": "deal",
                  "label": "Project",
                  "columns": [
                    {
                      "fields": [
                        {
                          "key": "title"
                        },
                        {
                          "key": "contact_id"
                        },
                        {
                          "key": "company_id"
                        }
                      ]
                    },
                    {
                      "fields": [
                        {
                          "key": "amount"
                        },
                        {
                          "key": "deadline"
                        },
                        {
                          "key": "expected_close_date"
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "pricing",
                  "label": "Pricing",
                  "columns": [
                    {
                      "fields": [
                        {
                          "key": "pricing_model"
                        },
                        {
                          "key": "hourly_rate",
                          "visible_when": {
                            "field": "pricing_model",
                            "operator": "eq",
                            "value": "hourly"
                          },
                          "required_when": {
                            "field": "pricing_model",
                            "operator": "eq",
                            "value": "hourly"
                          }
                        },
                        {
                          "key": "estimated_hours",
                          "visible_when": {
                            "field": "pricing_model",
                            "operator": "eq",
                            "value": "hourly"
                          }
                        }
                      ]
                    },
                    {
                      "fields": [
                        {
                          "key": "payment_terms"
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "deliverables",
                  "label": "Deliverables",
                  "columns": [
                    {
                      "fields": [
                        {
                          "key": "deliverables"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      {
        "record_type": "deal",
        "context": "edit",
        "layout": {
          "tabs": [
            {
              "id": "main",
              "label": "Details",
              "sections": [
                {
                  "id": "deal",
                  "label": "Project",
                  "columns": [
                    {
                      "fields": [
                        {
                          "key": "title"
                        },
                        {
                          "key": "contact_id"
                        },
                        {
                          "key": "company_id"
                        }
                      ]
                    },
                    {
                      "fields": [
                        {
                          "key": "amount"
                        },
                        {
                          "key": "deadline"
                        },
                        {
                          "key": "expected_close_date"
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "pricing",
                  "label": "Pricing",
                  "columns": [
                    {
                      "fields": [
                        {
                          "key": "pricing_model"
                        },
                        {
                          "key": "hourly_rate",
                          "visible_when": {
                            "field": "pricing_model",
                            "operator": "eq",
                            "value": "hourly"
                          },
                          "required_when": {
                            "field": "pricing_model",
                            "operator": "eq",
                            "value": "hourly"
                          }
                        },
                        {
                          "key": "estimated_hours",
                          "visible_when": {
                            "field": "pricing_model",
                            "operator": "eq",
                            "value": "hourly"
                          }
                        }
                      ]
                    },
                    {
                      "fields": [
                        {
                          "key": "payment_terms"
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "deliverables",
                  "label": "Deliverables",
                  "columns": [
                    {
                      "fields": [
                        {
                          "key": "deliverables"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      {
        "record_type": "contact",
        "context": "create",
        "layout": {
          "tabs": [
            {
              "id": "main",
              "label": "Details",
              "sections": [
                {
                  "id": "contact",
                  "label": "Client",
                  "columns": [
                    {
                      "fields": [
                        {
                          "key": "first_name"
                        },
                        {
                          "key": "last_name"
                        },
                        {
                          "key": "company_id"
                        }
                      ]
                    },
                    {
                      "fields": [
                        {
                          "key": "email"
                        },
                        {
                          "key": "phone"
                        },
                        {
                          "key": "portfolio_source"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      {
        "record_type": "contact",
        "context": "edit",
        "layout": {
          "tabs": [
            {
              "id": "main",
              "label": "Details",
              "sections": [
                {
                  "id": "contact",
                  "label": "Client",
                  "columns": [
                    {
                      "fields": [
                        {
                          "key": "first_name"
                        },
                        {
                          "key": "last_name"
                        },
                        {
                          "key": "company_id"
                        }
                      ]
                    },
                    {
                      "fields": [
                        {
                          "key": "email"
                        },
                        {
                          "key": "phone"
                        },
                        {
                          "key": "portfolio_source"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    ],
    "views": [
      {
        "key": "orcamentos_em_aberto",
        "record_type": "deal",
        "name": "Open quotes",
        "view_type": "table",
        "filter": {
          "field": "status",
          "operator": "eq",
          "value": "open"
        },
        "sort": [
          {
            "field": "expected_close_date",
            "direction": "asc"
          }
        ],
        "columns": [
          "title",
          "contact_id",
          "amount",
          "stage_id",
          "deadline"
        ]
      },
      {
        "key": "entregas_da_semana",
        "record_type": "deal",
        "name": "Deliveries in the next 7 days",
        "view_type": "table",
        "filter": {
          "op": "and",
          "conditions": [
            {
              "field": "status",
              "operator": "eq",
              "value": "won"
            },
            {
              "field": "deadline",
              "operator": "within_next_days",
              "value": 7
            }
          ]
        },
        "sort": [
          {
            "field": "deadline",
            "direction": "asc"
          }
        ],
        "columns": [
          "title",
          "contact_id",
          "deadline",
          "amount"
        ]
      },
      {
        "key": "projetos_fechados_no_mes",
        "record_type": "deal",
        "name": "Won this month",
        "view_type": "table",
        "filter": {
          "op": "and",
          "conditions": [
            {
              "field": "status",
              "operator": "eq",
              "value": "won"
            },
            {
              "field": "closed_at",
              "operator": "this_month"
            }
          ]
        },
        "sort": [
          {
            "field": "closed_at",
            "direction": "desc"
          }
        ],
        "columns": [
          "title",
          "contact_id",
          "amount",
          "payment_terms",
          "deadline"
        ]
      }
    ],
    "dashboard": {
      "widgets": [
        {
          "key": "pending_center",
          "size": "large"
        },
        {
          "key": "sales_indicators",
          "size": "medium"
        },
        {
          "key": "deals_by_stage",
          "size": "medium",
          "settings": {
            "pipeline": "projetos"
          }
        },
        {
          "key": "recent_activity",
          "size": "medium"
        }
      ],
      "period": "month"
    },
    "automations": [
      {
        "key": "follow_up_semanal",
        "name": "Weekly follow-up on open quotes",
        "description": "Every Monday at 9 AM, creates a follow-up task for each open quote",
        "record_type": "deal",
        "trigger": {
          "type": "time.schedule",
          "cron": "0 0 9 * * Mon",
          "filter": {
            "field": "status",
            "operator": "eq",
            "value": "open"
          }
        },
        "definition": {
          "start": "tarefa",
          "steps": [
            {
              "id": "tarefa",
              "type": "action",
              "action": "create_task",
              "config": {
                "title": "Follow up on the quote",
                "due_in": "1d",
                "activity_type": "follow_up",
                "assignee": {
                  "type": "record_owner"
                },
                "priority": "normal"
              }
            }
          ]
        }
      }
    ]
  }
}
