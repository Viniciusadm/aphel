    "task_types": [
      {
        "key": "visit",
        "name": "Visita",
        "icon": "map-pin",
        "color": "#bf8700"
      },
      {
        "key": "inspection",
        "name": "Vistoria",
        "icon": "flag",
        "color": "#d1631a"
