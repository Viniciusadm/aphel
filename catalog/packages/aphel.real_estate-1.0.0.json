        "layout": {
          "tabs": [
            {
              "id": "main",
              "label": "Dados",
              "sections": [
                {
                  "id": "deal",
                  "label": "Negócio",
                  "columns": [
                    {
                      "fields": [
                        {
                          "key": "title"
                        },
                        {
                          "key": "business_type"
                        },
                        {
                          "key": "contact_id"
                        }
                      ]
                    },
                    {
                      "fields": [
                        {
                          "key": "owner_id"
                        },
                        {
                          "key": "expected_close_date"
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "property",
                  "label": "Imóvel",
                  "columns": [
                    {
                      "fields": [
                        {
                          "key": "property_type"
                        },
                        {
                          "key": "property_code"
                        }
                      ]
                    },
                    {
                      "fields": [
                        {
                          "key": "neighborhood"
                        },
                        {
                          "key": "amount"
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "sale",
                  "label": "Dados da venda",
                  "columns": [
                    {
                      "fields": [
                        {
                          "key": "payment_method",
                          "visible_when": {
                            "field": "business_type",
                            "operator": "eq",
                            "value": "sale"
                          }
                        }
                      ]
                    },
                    {
                      "fields": [
                        {
                          "key": "financing_approved",
                          "visible_when": {
                            "field": "business_type",
                            "operator": "eq",
                            "value": "sale"
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "rental",
                  "label": "Dados da locação",
                  "columns": [
                    {
                      "fields": [
                        {
                          "key": "rent_amount",
                          "visible_when": {
                            "field": "business_type",
                            "operator": "eq",
                            "value": "rental"
                          },
                          "required_when": {
                            "field": "business_type",
                            "operator": "eq",
                            "value": "rental"
                          }
                        },
                        {
                          "key": "condo_fee",
                          "visible_when": {
                            "field": "business_type",
                            "operator": "eq",
                            "value": "rental"
                          }
                        },
                        {
                          "key": "rental_guarantee",
