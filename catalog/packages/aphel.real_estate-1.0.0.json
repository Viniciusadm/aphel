    "views": [
      {
        "key": "vendas_em_aberto",
        "record_type": "deal",
        "name": "Vendas em aberto",
        "view_type": "table",
        "filter": {
          "op": "and",
          "conditions": [
            {
              "field": "status",
              "operator": "eq",
              "value": "open"
            },
            {
              "field": "business_type",
              "operator": "eq",
              "value": "sale"
            }
          ]
        },
        "sort": [
          {
            "field": "expected_close_date",
            "direction": "asc"
          }
        ],
        "columns": [
          "title",
          "contact_id",
          "property_code",
          "amount",
          "stage_id",
          "owner_id"
        ]
      },
      {
        "key": "locacoes_em_aberto",
        "record_type": "deal",
        "name": "Locações em aberto",
        "view_type": "table",
        "filter": {
          "op": "and",
          "conditions": [
            {
              "field": "status",
              "operator": "eq",
              "value": "open"
            },
            {
              "field": "business_type",
              "operator": "eq",
              "value": "rental"
            }
          ]
        },
        "sort": [
          {
            "field": "expected_close_date",
            "direction": "asc"
          }
        ],
        "columns": [
          "title",
          "contact_id",
          "property_code",
          "rent_amount",
          "rental_guarantee",
          "stage_id",
          "owner_id"
        ]
      },
      {
        "key": "entradas_proximas",
        "record_type": "deal",
        "name": "Entradas nos próximos 30 dias",
        "view_type": "table",
        "filter": {
          "op": "and",
          "conditions": [
            {
              "field": "business_type",
              "operator": "eq",
              "value": "rental"
            },
            {
              "field": "move_in_date",
              "operator": "within_next_days",
              "value": 30
            }
          ]
        },
        "sort": [
          {
            "field": "move_in_date",
            "direction": "asc"
          }
        ],
        "columns": [
          "title",
          "contact_id",
          "property_code",
          "move_in_date",
          "owner_id"
        ]
      },
      {
        "key": "proprietarios",
        "record_type": "contact",
        "name": "Proprietários",
        "view_type": "table",
        "filter": {
          "field": "client_profile",
          "operator": "eq",
          "value": "owner"
        },
        "columns": [
          "name",
          "phone",
          "email",
          "owner_id"
        ]
      }
    ],
