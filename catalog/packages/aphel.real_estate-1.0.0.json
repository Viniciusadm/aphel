{
  "format": "aphel-config",
  "format_version": 1,
  "min_aphel_version": "0.1.0",
  "id": "aphel.real_estate",
  "version": "1.0.0",
  "name": "Imobiliária",
  "description": "Para imobiliárias e corretores: funis de venda e de locação, dados do imóvel, campos de locação que só aparecem quando o negócio é locação, visitas, vistorias e etiquetas de perfil do cliente.",
  "author": "Aphel",
  "locale": "pt-BR",
  "sections": {
    "fields": [
      {
        "record_type": "deal",
        "key": "business_type",
        "label": "Tipo de negócio",
        "type": "select",
        "options": [
          {
            "value": "sale",
            "label": "Venda",
            "color": "#1f6feb"
          },
          {
            "value": "rental",
            "label": "Locação",
            "color": "#1a7f37"
          }
        ]
      },
      {
        "record_type": "deal",
        "key": "property_type",
        "label": "Tipo de imóvel",
        "type": "select",
        "options": [
          {
            "value": "apartment",
            "label": "Apartamento",
            "color": "#1f6feb"
          },
          {
            "value": "house",
            "label": "Casa",
            "color": "#1a7f37"
          },
          {
            "value": "condo_house",
            "label": "Casa em condomínio",
            "color": "#0f766e"
          },
          {
            "value": "land",
            "label": "Terreno",
            "color": "#bf8700"
          },
          {
            "value": "commercial",
            "label": "Comercial",
            "color": "#8250df"
          },
          {
            "value": "rural",
            "label": "Rural",
            "color": "#4d7c0f"
          }
        ]
      },
      {
        "record_type": "deal",
        "key": "property_code",
        "label": "Código do imóvel",
        "type": "text",
        "searchable": true
      },
      {
        "record_type": "deal",
        "key": "neighborhood",
        "label": "Bairro",
        "type": "text"
      },
      {
        "record_type": "deal",
        "key": "payment_method",
        "label": "Forma de pagamento",
        "type": "select",
        "options": [
          {
            "value": "cash",
            "label": "À vista",
            "color": "#1a7f37"
          },
          {
            "value": "financing",
            "label": "Financiamento",
            "color": "#1f6feb"
          },
          {
            "value": "fgts",
            "label": "Financiamento com FGTS",
            "color": "#0f766e"
          },
          {
            "value": "consortium",
            "label": "Consórcio",
            "color": "#8250df"
          },
          {
            "value": "exchange",
            "label": "Permuta",
            "color": "#d1631a"
          }
        ]
      },
      {
        "record_type": "deal",
        "key": "financing_approved",
        "label": "Crédito aprovado",
        "type": "checkbox"
      },
      {
        "record_type": "deal",
        "key": "rent_amount",
        "label": "Valor do aluguel",
        "type": "currency",
        "config": {
          "currency": "BRL"
        }
      },
      {
        "record_type": "deal",
        "key": "condo_fee",
        "label": "Condomínio + IPTU (mensal)",
        "type": "currency",
        "config": {
          "currency": "BRL"
        }
      },
      {
        "record_type": "deal",
        "key": "rental_guarantee",
        "label": "Garantia locatícia",
        "type": "select",
        "options": [
          {
            "value": "guarantor",
            "label": "Fiador",
            "color": "#1f6feb"
          },
          {
            "value": "bail_insurance",
            "label": "Seguro fiança",
            "color": "#1a7f37"
          },
          {
            "value": "deposit",
            "label": "Caução",
            "color": "#bf8700"
          },
          {
            "value": "capitalization",
            "label": "Título de capitalização",
            "color": "#8250df"
          },
          {
            "value": "none",
            "label": "Sem garantia",
            "color": "#6e7781"
          }
        ]
      },
      {
        "record_type": "deal",
        "key": "contract_months",
        "label": "Prazo do contrato (meses)",
        "type": "number",
        "config": {
          "min": 1,
          "decimals": 0
        }
      },
      {
        "record_type": "deal",
        "key": "move_in_date",
        "label": "Data de entrada no imóvel",
        "type": "date"
      },
      {
        "record_type": "contact",
        "key": "client_profile",
        "label": "Perfil do cliente",
        "type": "select",
        "options": [
          {
            "value": "buyer",
            "label": "Comprador",
            "color": "#1f6feb"
          },
          {
            "value": "tenant",
            "label": "Locatário",
            "color": "#1a7f37"
          },
          {
            "value": "owner",
            "label": "Proprietário",
            "color": "#8250df"
          }
        ]
      },
      {
        "record_type": "contact",
        "key": "max_budget",
        "label": "Orçamento máximo",
        "type": "currency",
        "config": {
          "currency": "BRL"
        }
      },
      {
        "record_type": "contact",
        "key": "desired_neighborhoods",
        "label": "Bairros de interesse",
        "type": "text"
      },
      {
        "record_type": "contact",
        "key": "bedrooms",
        "label": "Dormitórios desejados",
        "type": "number",
        "config": {
          "min": 0,
          "decimals": 0
        }
      }
    ],
    "workflow": [
      {
        "key": "venda",
        "name": "Venda",
        "default": true,
        "stages": [
          {
            "key": "prospeccao",
            "name": "Atendimento",
            "kind": "open",
            "probability": 10
          },
          {
            "key": "qualificacao",
            "name": "Visita",
            "kind": "open",
            "probability": 25
          },
          {
            "key": "proposta",
            "name": "Proposta",
            "kind": "open",
            "probability": 50,
            "entry_required_fields": [
              "amount"
            ]
          },
          {
            "key": "negociacao",
            "name": "Negociação",
            "kind": "open",
            "probability": 70
          },
          {
            "key": "documentacao",
            "name": "Documentação e financiamento",
            "kind": "open",
            "probability": 90,
            "entry_required_fields": [
              "payment_method"
            ]
          },
          {
            "key": "ganho",
            "name": "Vendido",
            "kind": "won",
            "probability": 100
          },
          {
            "key": "perdido",
            "name": "Perdido",
            "kind": "lost",
            "probability": 0
          }
        ]
      },
      {
        "key": "locacao",
        "name": "Locação",
        "stages": [
          {
            "key": "atendimento",
            "name": "Atendimento",
            "kind": "open",
            "probability": 10
          },
          {
            "key": "visita",
            "name": "Visita",
            "kind": "open",
            "probability": 30
          },
          {
            "key": "analise_cadastral",
            "name": "Análise cadastral",
            "kind": "open",
            "probability": 60,
            "entry_required_fields": [
              "rent_amount",
              "rental_guarantee"
            ]
          },
          {
            "key": "contrato",
            "name": "Contrato",
            "kind": "open",
            "probability": 85,
            "entry_required_fields": [
              "contract_months",
              "move_in_date"
            ]
          },
          {
            "key": "alugado",
            "name": "Alugado",
            "kind": "won",
            "probability": 100
          },
          {
            "key": "perdido",
            "name": "Perdido",
            "kind": "lost",
            "probability": 0
          }
        ]
      }
    ],
    "lost_reasons": [
      {
        "key": "preco",
        "name": "Preço"
      },
      {
        "key": "escolheu_um_concorrente",
        "name": "Escolheu um concorrente"
      },
      {
        "key": "sem_orcamento",
        "name": "Sem orçamento"
      },
      {
        "key": "sem_resposta",
        "name": "Sem resposta"
      },
      {
        "key": "momento_inadequado",
        "name": "Momento inadequado"
      },
      {
        "key": "outro",
        "name": "Outro"
      },
      {
        "key": "credito_reprovado",
        "name": "Crédito ou cadastro reprovado"
      },
      {
        "key": "imovel_indisponivel",
        "name": "Imóvel já negociado"
      },
      {
        "key": "desistiu_do_imovel",
        "name": "Desistiu após a visita"
      }
