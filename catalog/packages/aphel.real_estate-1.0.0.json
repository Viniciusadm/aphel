                            "operator": "eq",
                            "value": "rental"
                          }
                        }
                      ]
                    },
                    {
                      "fields": [
                        {
                          "key": "contract_months",
                          "visible_when": {
                            "field": "business_type",
                            "operator": "eq",
                            "value": "rental"
                          }
                        },
                        {
                          "key": "move_in_date",
                          "visible_when": {
                            "field": "business_type",
                            "operator": "eq",
                            "value": "rental"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
