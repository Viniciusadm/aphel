    "views": [
      {
        "key": "projetos_em_aberto",
        "record_type": "deal",
        "name": "Projects in negotiation",
        "view_type": "table",
        "filter": {
          "field": "status",
          "operator": "eq",
          "value": "open"
        },
        "sort": [
          {
            "field": "expected_close_date",
            "direction": "asc"
          }
        ],
        "columns": [
          "title",
          "company_id",
          "services",
          "amount",
          "stage_id",
          "owner_id"
        ]
      },
      {
        "key": "contratos_vencendo",
        "record_type": "deal",
        "name": "Contracts expiring in 60 days",
        "view_type": "table",
        "filter": {
          "op": "and",
          "conditions": [
            {
              "field": "status",
              "operator": "eq",
              "value": "won"
            },
            {
              "field": "contract_end_date",
              "operator": "within_next_days",
              "value": 60
            }
          ]
        },
        "sort": [
          {
            "field": "contract_end_date",
            "direction": "asc"
          }
        ],
        "columns": [
          "title",
          "company_id",
          "monthly_fee",
          "contract_end_date",
          "owner_id"
        ]
      },
      {
        "key": "entregas_proximas",
        "record_type": "deal",
        "name": "Deliveries in the next 15 days",
        "view_type": "table",
        "filter": {
          "op": "and",
          "conditions": [
            {
              "field": "status",
              "operator": "eq",
              "value": "won"
            },
            {
              "field": "delivery_date",
              "operator": "within_next_days",
              "value": 15
            }
          ]
        },
        "sort": [
          {
            "field": "delivery_date",
            "direction": "asc"
          }
        ],
        "columns": [
          "title",
          "company_id",
          "services",
          "delivery_date",
          "owner_id"
        ]
      }
    ],
    "dashboard": {
      "widgets": [
        {
          "key": "sales_indicators",
          "size": "large"
        },
        {
          "key": "deals_by_stage",
          "size": "medium",
          "settings": {
            "pipeline": "novos_projetos"
          }
        },
        {
          "key": "deals_by_stage",
          "size": "medium",
          "settings": {
            "pipeline": "renovacoes"
          }
        },
        {
          "key": "pending_center",
          "size": "medium"
        },
        {
          "key": "recent_activity",
          "size": "medium"
        }
      ],
