{
  "format": "aphel-config",
  "format_version": 1,
  "min_aphel_version": "0.1.0",
  "id": "aphel.agency.en",
  "version": "1.0.0",
  "name": "Agency",
  "description": "For marketing, design and development agencies: new projects and contract renewals in separate workflow, with scope, contracted services, monthly retainer, and briefing and presentation activities.",
  "author": "Aphel",
  "locale": "en",
  "sections": {
    "fields": [
      {
        "record_type": "deal",
        "key": "services",
        "label": "Services",
        "type": "multi_select",
        "options": [
          {
            "value": "website",
            "label": "Website",
            "color": "#1f6feb"
          },
          {
            "value": "branding",
            "label": "Branding",
            "color": "#8250df"
          },
          {
            "value": "social_media",
            "label": "Social media",
            "color": "#bf3989"
          },
          {
            "value": "paid_media",
            "label": "Paid media",
            "color": "#d1631a"
          },
          {
            "value": "seo",
            "label": "SEO",
            "color": "#1a7f37"
          },
          {
            "value": "content",
            "label": "Content",
            "color": "#0f766e"
          },
          {
            "value": "video",
            "label": "Video",
            "color": "#cf222e"
          },
          {
            "value": "software",
            "label": "Software development",
            "color": "#4f46e5"
          }
        ]
      },
      {
        "record_type": "deal",
        "key": "billing_model",
        "label": "Engagement model",
        "type": "select",
        "options": [
          {
            "value": "project",
            "label": "Fixed-price project",
            "color": "#1f6feb"
          },
          {
            "value": "retainer",
            "label": "Monthly retainer",
            "color": "#1a7f37"
          },
          {
            "value": "hourly",
            "label": "Prepaid hours",
            "color": "#bf8700"
          }
        ]
      },
      {
        "record_type": "deal",
        "key": "monthly_fee",
        "label": "Monthly fee",
        "type": "currency"
      },
      {
        "record_type": "deal",
        "key": "contract_months",
        "label": "Contract length (months)",
        "type": "number",
        "config": {
          "min": 1,
          "decimals": 0
        }
      },
      {
        "record_type": "deal",
        "key": "scope",
        "label": "Scope",
        "type": "long_text"
      },
      {
        "record_type": "deal",
        "key": "briefing_url",
        "label": "Brief link",
        "type": "url"
      },
      {
        "record_type": "deal",
        "key": "delivery_date",
        "label": "Delivery date",
        "type": "date"
      },
      {
        "record_type": "deal",
        "key": "contract_end_date",
        "label": "Contract end date",
        "type": "date"
      },
      {
        "record_type": "company",
        "key": "client_since",
        "label": "Client since",
        "type": "date"
      },
      {
        "record_type": "company",
        "key": "account_manager",
        "label": "Account manager",
        "type": "user"
      },
      {
        "record_type": "company",
        "key": "channels",
        "label": "Active channels",
        "type": "multi_select",
        "options": [
          {
            "value": "instagram",
            "label": "Instagram",
            "color": "#bf3989"
          },
          {
            "value": "facebook",
            "label": "Facebook",
            "color": "#1f6feb"
          },
          {
            "value": "linkedin",
            "label": "LinkedIn",
            "color": "#4f46e5"
          },
          {
            "value": "tiktok",
            "label": "TikTok",
            "color": "#6e7781"
          },
          {
            "value": "youtube",
            "label": "YouTube",
            "color": "#cf222e"
          },
          {
            "value": "google",
            "label": "Google",
            "color": "#1a7f37"
          }
        ]
      }
    ],
    "workflow": [
      {
        "key": "novos_projetos",
        "name": "New projects",
        "default": true,
        "stages": [
          {
            "key": "prospeccao",
            "name": "Initial contact",
            "kind": "open",
            "probability": 10
          },
          {
            "key": "qualificacao",
            "name": "Briefing",
            "kind": "open",
            "probability": 25,
            "exit_required_fields": [
              "services"
            ]
          },
          {
            "key": "proposta",
            "name": "Proposal sent",
            "kind": "open",
            "probability": 50,
            "entry_required_fields": [
              "amount",
              "scope"
            ]
          },
          {
            "key": "negociacao",
            "name": "Negotiation",
            "kind": "open",
            "probability": 75
          },
          {
            "key": "ganho",
            "name": "Won",
            "kind": "won",
            "probability": 100
          },
          {
            "key": "perdido",
            "name": "Lost",
            "kind": "lost",
            "probability": 0
          }
        ]
      },
      {
        "key": "renovacoes",
        "name": "Renewals",
        "stages": [
          {
            "key": "contrato_a_vencer",
            "name": "Contract expiring",
            "kind": "open",
            "probability": 50,
            "exit_required_fields": [
              "contract_end_date"
            ]
          },
          {
            "key": "apresentacao_resultados",
            "name": "Results review",
            "kind": "open",
            "probability": 65
          },
          {
            "key": "proposta_renovacao",
            "name": "Renewal proposal",
            "kind": "open",
            "probability": 80,
            "entry_required_fields": [
              "amount"
            ]
          },
          {
            "key": "renovado",
            "name": "Renewed",
            "kind": "won",
            "probability": 100
          },
          {
            "key": "nao_renovado",
            "name": "Not renewed",
            "kind": "lost",
            "probability": 0
          }
        ]
      }
    ],
    "lost_reasons": [
      {
        "key": "preco",
        "name": "Price"
      },
      {
        "key": "escolheu_um_concorrente",
        "name": "Chose a competitor"
      },
      {
        "key": "sem_orcamento",
        "name": "No budget"
      },
      {
        "key": "sem_resposta",
        "name": "No response"
      },
      {
        "key": "momento_inadequado",
        "name": "Bad timing"
      },
      {
        "key": "outro",
        "name": "Other"
      },
      {
        "key": "escopo_fora_do_perfil",
        "name": "Scope outside our expertise"
      },
      {
        "key": "prazo_inviavel",
        "name": "Unrealistic deadline"
      },
      {
        "key": "levou_para_dentro_de_casa",
        "name": "Client took the work in-house"
      }
    ],
    "activity_types": [
      {
        "key": "briefing",
        "name": "Briefing",
        "icon": "file-text",
        "color": "#0f766e"
      },
      {
        "key": "presentation",
        "name": "Presentation",
        "icon": "presentation",
        "color": "#8250df"
      },
      {
        "key": "delivery",
        "name": "Delivery",
        "icon": "send",
        "color": "#1a7f37"
      }
    ],
    "layouts": [
      {
        "record_type": "deal",
        "context": "create",
        "layout": {
          "tabs": [
            {
              "id": "main",
              "label": "Details",
              "sections": [
                {
                  "id": "deal",
                  "label": "Deal",
                  "columns": [
                    {
                      "fields": [
                        {
                          "key": "title"
                        },
                        {
                          "key": "company_id"
                        },
                        {
                          "key": "contact_id"
                        }
                      ]
                    },
                    {
                      "fields": [
                        {
                          "key": "amount"
                        },
                        {
                          "key": "expected_close_date"
                        },
                        {
                          "key": "owner_id"
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "scope",
                  "label": "Scope and engagement",
                  "columns": [
                    {
                      "fields": [
                        {
                          "key": "services"
                        },
                        {
                          "key": "billing_model"
                        },
                        {
                          "key": "monthly_fee",
                          "visible_when": {
                            "field": "billing_model",
                            "operator": "eq",
                            "value": "retainer"
                          },
                          "required_when": {
                            "field": "billing_model",
                            "operator": "eq",
                            "value": "retainer"
                          }
                        },
                        {
                          "key": "contract_months",
                          "visible_when": {
                            "field": "billing_model",
                            "operator": "eq",
                            "value": "retainer"
                          }
                        }
                      ]
                    },
                    {
                      "fields": [
                        {
                          "key": "delivery_date"
                        },
                        {
                          "key": "contract_end_date"
                        },
                        {
                          "key": "briefing_url"
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "details",
                  "label": "Scope details",
                  "columns": [
                    {
                      "fields": [
                        {
                          "key": "scope"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
