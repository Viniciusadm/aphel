{
  "format": "aphel-config",
  "format_version": 1,
  "min_aphel_version": "0.1.0",
  "name": "Vendas B2B",
  "description": "Funil consultivo para vender a outras empresas: qualificação, demonstração, proposta e negociação, com segmento, porte e faturamento das contas e indicadores de conversão.",
  "author": "Aphel",
  "locale": "pt-BR",
  "sections": {
    "fields": [
      {
        "record_type": "organizations.organization",
        "key": "sector",
        "label": "Setor de atuação",
        "type": "select",
        "options": [
          {
            "value": "industry",
            "label": "Indústria",
            "color": "#1f6feb"
          },
          {
            "value": "retail",
            "label": "Varejo",
            "color": "#d1631a"
          },
          {
            "value": "services",
            "label": "Serviços",
