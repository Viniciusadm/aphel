        "record_type": "deals.deal",
        "key": "decision_maker_confirmed",
        "label": "Decisor identificado",
        "type": "checkbox"
      },
      {
        "record_type": "deals.deal",
        "key": "competitors",
        "label": "Concorrentes na disputa",
        "type": "text"
      },
      {
        "record_type": "deals.deal",
        "key": "next_step",
        "label": "Próximo passo",
        "type": "text"
      },
      {
        "record_type": "deals.deal",
        "key": "demo_date",
        "label": "Data da demonstração",
        "type": "date"
      }
    ],
    "workflow": [
      {
        "key": "vendas_b2b",
        "name": "Vendas B2B",
        "default": true,
        "stages": [
          {
            "key": "prospeccao",
            "name": "Prospecção",
            "kind": "open",
            "probability": 10
          },
          {
            "key": "qualificacao",
            "name": "Qualificação",
            "kind": "open",
            "probability": 20,
            "exit_required_fields": [
              "company_id",
              "contact_id"
            ]
          },
          {
            "key": "demonstracao",
            "name": "Demonstração",
            "kind": "open",
            "probability": 35
          },
          {
            "key": "proposta",
            "name": "Proposta",
            "kind": "open",
            "probability": 50,
            "entry_required_fields": [
              "amount",
              "expected_close_date"
            ]
          },
          {
            "key": "negociacao",
            "name": "Negociação",
            "kind": "open",
            "probability": 75,
            "entry_required_fields": [
              "amount"
            ]
          },
          {
            "key": "ganho",
            "name": "Ganho",
            "kind": "won",
            "probability": 100
          },
          {
            "key": "perdido",
            "name": "Perdido",
            "kind": "lost",
            "probability": 0
          }
        ]
      }
    ],
    "lost_reasons": [
