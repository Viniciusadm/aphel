    "views": [
      {
        "key": "negocios_em_aberto",
        "record_type": "deals.deal",
        "name": "Negócios em aberto",
        "view_type": "table",
        "filter": {
          "field": "status",
          "operator": "eq",
          "value": "open"
        },
        "sort": [
          {
            "field": "expected_close_date",
            "direction": "asc"
          }
        ],
        "columns": [
          "title",
          "company_id",
          "amount",
          "stage_id",
          "expected_close_date",
          "owner_id"
        ]
      },
      {
        "key": "fechamento_este_mes",
        "record_type": "deals.deal",
        "name": "Fechamento previsto este mês",
        "view_type": "table",
        "filter": {
          "op": "and",
          "conditions": [
            {
              "field": "status",
              "operator": "eq",
              "value": "open"
            },
            {
              "field": "expected_close_date",
              "operator": "this_month"
            }
          ]
        },
        "sort": [
          {
            "field": "amount",
            "direction": "desc"
          }
        ],
        "columns": [
          "title",
          "company_id",
          "amount",
          "stage_id",
          "probability",
          "owner_id"
        ]
      },
      {
        "key": "contas_estrategicas",
        "record_type": "organizations.organization",
        "name": "Contas estratégicas",
        "view_type": "table",
        "filter": {
          "field": "account_tier",
          "operator": "in",
          "value": [
            "strategic",
            "key"
          ]
        },
        "columns": [
          "name",
          "sector",
          "size_range",
          "annual_revenue",
          "owner_id"
        ]
      },
      {
        "key": "decisores",
        "record_type": "people.person",
        "name": "Decisores",
        "view_type": "table",
        "filter": {
          "field": "buying_role",
          "operator": "eq",
          "value": "decision_maker"
        },
        "columns": [
          "name",
          "job_title",
          "company_id",
          "email",
          "phone"
        ]
      }
    ],
