        "options": [
          {
            "value": "decision_maker",
            "label": "Decisor",
            "color": "#cf222e"
          },
          {
            "value": "influencer",
            "label": "Influenciador",
            "color": "#d1631a"
          },
          {
            "value": "champion",
            "label": "Patrocinador interno",
            "color": "#1a7f37"
          },
          {
            "value": "technical",
            "label": "Avaliador técnico",
            "color": "#1f6feb"
          },
          {
            "value": "finance",
            "label": "Financeiro/compras",
            "color": "#8250df"
          },
          {
            "value": "user",
            "label": "Usuário",
            "color": "#6e7781"
          }
        ]
      },
      {
        "record_type": "deals.deal",
        "key": "deal_type",
        "label": "Tipo de negócio",
        "type": "select",
        "options": [
          {
            "value": "new_business",
            "label": "Novo cliente",
            "color": "#1f6feb"
          },
          {
            "value": "expansion",
            "label": "Expansão",
            "color": "#1a7f37"
          },
          {
            "value": "renewal",
            "label": "Renovação",
            "color": "#8250df"
          }
