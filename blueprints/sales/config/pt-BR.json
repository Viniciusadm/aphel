            "label": "Setor público",
            "color": "#6e7781"
          },
          {
            "value": "other",
            "label": "Outro",
            "color": "#6e7781"
          }
        ]
      },
      {
        "record_type": "organizations.organization",
        "key": "annual_revenue",
        "label": "Faturamento anual",
        "type": "select",
        "options": [
          {
            "value": "up_to_360k",
            "label": "Até R$ 360 mil",
            "color": "#6e7781"
          },
          {
            "value": "up_to_4_8m",
            "label": "R$ 360 mil a R$ 4,8 milhões",
            "color": "#1f6feb"
          },
          {
            "value": "up_to_30m",
            "label": "R$ 4,8 a R$ 30 milhões",
            "color": "#0f766e"
          },
          {
            "value": "up_to_300m",
            "label": "R$ 30 a R$ 300 milhões",
            "color": "#8250df"
          },
          {
            "value": "above_300m",
            "label": "Acima de R$ 300 milhões",
            "color": "#1a7f37"
          }
        ]
      },
