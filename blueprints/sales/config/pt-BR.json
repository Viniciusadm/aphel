            "value": "strategic",
            "label": "Estratégica",
            "color": "#cf222e"
          },
          {
            "value": "key",
            "label": "Chave",
            "color": "#d1631a"
          },
          {
            "value": "standard",
            "label": "Padrão",
            "color": "#1f6feb"
          }
        ]
      },
