{
  "format": "aphel-config",
  "format_version": 1,
  "min_aphel_version": "0.1.0",
  "name": "Freelancer",
  "description": "Funil enxuto para quem trabalha sozinho: do primeiro contato ao orçamento aprovado, com valor/hora, horas estimadas, prazo de entrega e condição de pagamento.",
  "author": "Aphel",
  "locale": "pt-BR",
  "sections": {
    "fields": [
      {
        "record_type": "deals.deal",
        "key": "pricing_model",
        "label": "Forma de cobrança",
        "type": "select",
        "options": [
          {
            "value": "fixed",
            "label": "Preço fechado",
            "color": "#1f6feb"
          },
          {
            "value": "hourly",
            "label": "Por hora",
            "color": "#bf8700"
          }
        ]
      },
      {
        "record_type": "deals.deal",
        "key": "hourly_rate",
        "label": "Valor/hora",
        "type": "currency",
        "config": {
          "currency": "BRL"
        }
      },
      {
        "record_type": "deals.deal",
        "key": "estimated_hours",
        "label": "Horas estimadas",
        "type": "number",
        "config": {
          "min": 0,
          "decimals": 1
        }
      },
      {
        "record_type": "deals.deal",
        "key": "deadline",
        "label": "Prazo de entrega",
        "type": "date"
      },
      {
        "record_type": "deals.deal",
        "key": "payment_terms",
        "label": "Condição de pagamento",
        "type": "select",
        "options": [
          {
            "value": "upfront",
            "label": "À vista",
            "color": "#1a7f37"
          },
          {
            "value": "half_half",
            "label": "50% na entrada e 50% na entrega",
            "color": "#1f6feb"
          },
          {
            "value": "installments",
            "label": "Parcelado",
            "color": "#8250df"
          },
          {
            "value": "monthly",
            "label": "Mensal",
            "color": "#0f766e"
          }
        ]
      },
      {
        "record_type": "deals.deal",
        "key": "deliverables",
        "label": "Entregáveis",
        "type": "long_text"
      },
      {
        "record_type": "people.person",
        "key": "portfolio_source",
        "label": "Como me conheceu",
        "type": "select",
        "options": [
          {
            "value": "referral",
            "label": "Indicação",
            "color": "#1a7f37"
          },
          {
            "value": "social_media",
            "label": "Redes sociais",
            "color": "#bf3989"
          },
          {
            "value": "marketplace",
            "label": "Plataforma de freelas",
            "color": "#d1631a"
          },
          {
            "value": "website",
            "label": "Site/portfólio",
            "color": "#1f6feb"
          },
          {
            "value": "returning",
            "label": "Cliente recorrente",
            "color": "#8250df"
          }
        ]
      }
    ],
    "workflow": [
      {
        "key": "projetos",
        "name": "Projetos",
        "default": true,
        "stages": [
          {
            "key": "prospeccao",
            "name": "Novo contato",
            "kind": "open",
            "probability": 10
          },
          {
            "key": "qualificacao",
            "name": "Briefing",
            "kind": "open",
            "probability": 30
          },
          {
            "key": "proposta",
            "name": "Orçamento enviado",
            "kind": "open",
            "probability": 50,
            "entry_required_fields": [
              "amount",
              "deadline"
            ]
          },
          {
            "key": "negociacao",
            "name": "Aguardando aprovação",
            "kind": "open",
            "probability": 75
          },
          {
            "key": "ganho",
            "name": "Fechado",
            "kind": "won",
            "probability": 100
          },
          {
            "key": "perdido",
            "name": "Perdido",
            "kind": "lost",
            "probability": 0
          }
        ]
      }
    ],
    "lost_reasons": [
      {
        "key": "preco",
        "name": "Preço"
      },
      {
        "key": "escolheu_um_concorrente",
        "name": "Escolheu um concorrente"
      },
      {
        "key": "sem_orcamento",
        "name": "Sem orçamento"
      },
      {
        "key": "sem_resposta",
        "name": "Sem resposta"
      },
      {
        "key": "momento_inadequado",
        "name": "Momento inadequado"
      },
      {
        "key": "outro",
        "name": "Outro"
      },
      {
        "key": "prazo_incompativel",
        "name": "Prazo incompatível com a agenda"
      }
    ],
    "task_types": [
      {
        "key": "follow_up",
        "name": "Acompanhamento",
        "icon": "repeat",
        "color": "#0f766e"
      },
      {
        "key": "delivery",
        "name": "Entrega",
        "icon": "send",
        "color": "#1a7f37"
      }
    ],
    "layouts": [
      {
        "record_type": "deals.deal",
        "context": "create",
        "layout": {
          "tabs": [
            {
              "id": "main",
              "label": "Dados",
              "sections": [
                {
                  "id": "deal",
                  "label": "Projeto",
                  "columns": [
                    {
                      "fields": [
                        {
                          "key": "title"
                        },
                        {
                          "key": "contact_id"
                        },
                        {
                          "key": "company_id"
                        }
                      ]
                    },
                    {
                      "fields": [
                        {
                          "key": "amount"
                        },
                        {
                          "key": "deadline"
                        },
                        {
                          "key": "expected_close_date"
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "pricing",
                  "label": "Cobrança",
                  "columns": [
                    {
                      "fields": [
                        {
                          "key": "pricing_model"
                        },
                        {
                          "key": "hourly_rate",
                          "visible_when": {
                            "field": "pricing_model",
                            "operator": "eq",
                            "value": "hourly"
                          },
                          "required_when": {
                            "field": "pricing_model",
                            "operator": "eq",
                            "value": "hourly"
                          }
                        },
                        {
                          "key": "estimated_hours",
                          "visible_when": {
                            "field": "pricing_model",
                            "operator": "eq",
                            "value": "hourly"
                          }
                        }
                      ]
                    },
                    {
                      "fields": [
                        {
                          "key": "payment_terms"
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "deliverables",
                  "label": "Entregáveis",
                  "columns": [
                    {
                      "fields": [
                        {
                          "key": "deliverables"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      {
        "record_type": "deals.deal",
        "context": "edit",
        "layout": {
          "tabs": [
            {
              "id": "main",
              "label": "Dados",
              "sections": [
                {
                  "id": "deal",
                  "label": "Projeto",
                  "columns": [
                    {
                      "fields": [
                        {
                          "key": "title"
                        },
                        {
                          "key": "contact_id"
                        },
                        {
                          "key": "company_id"
                        }
                      ]
                    },
                    {
                      "fields": [
                        {
                          "key": "amount"
                        },
                        {
                          "key": "deadline"
                        },
                        {
                          "key": "expected_close_date"
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "pricing",
                  "label": "Cobrança",
                  "columns": [
                    {
                      "fields": [
                        {
                          "key": "pricing_model"
                        },
                        {
                          "key": "hourly_rate",
                          "visible_when": {
                            "field": "pricing_model",
                            "operator": "eq",
                            "value": "hourly"
                          },
                          "required_when": {
                            "field": "pricing_model",
                            "operator": "eq",
                            "value": "hourly"
                          }
                        },
                        {
                          "key": "estimated_hours",
                          "visible_when": {
                            "field": "pricing_model",
                            "operator": "eq",
                            "value": "hourly"
                          }
                        }
                      ]
                    },
                    {
                      "fields": [
                        {
                          "key": "payment_terms"
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "deliverables",
                  "label": "Entregáveis",
                  "columns": [
                    {
                      "fields": [
                        {
                          "key": "deliverables"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      {
        "record_type": "people.person",
        "context": "create",
        "layout": {
          "tabs": [
            {
              "id": "main",
              "label": "Dados",
              "sections": [
                {
                  "id": "contact",
                  "label": "Cliente",
                  "columns": [
                    {
                      "fields": [
                        {
                          "key": "first_name"
                        },
                        {
                          "key": "last_name"
                        },
                        {
                          "key": "company_id"
                        }
                      ]
                    },
                    {
                      "fields": [
                        {
                          "key": "email"
                        },
                        {
                          "key": "phone"
                        },
                        {
                          "key": "portfolio_source"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      {
        "record_type": "people.person",
        "context": "edit",
        "layout": {
          "tabs": [
            {
              "id": "main",
              "label": "Dados",
              "sections": [
                {
                  "id": "contact",
                  "label": "Cliente",
                  "columns": [
                    {
                      "fields": [
                        {
                          "key": "first_name"
                        },
                        {
                          "key": "last_name"
                        },
                        {
                          "key": "company_id"
                        }
                      ]
                    },
                    {
                      "fields": [
                        {
                          "key": "email"
                        },
                        {
                          "key": "phone"
                        },
                        {
                          "key": "portfolio_source"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    ],
    "views": [
      {
        "key": "orcamentos_em_aberto",
        "record_type": "deals.deal",
        "name": "Orçamentos em aberto",
        "view_type": "table",
        "filter": {
          "field": "status",
          "operator": "eq",
          "value": "open"
        },
        "sort": [
          {
            "field": "expected_close_date",
            "direction": "asc"
          }
        ],
        "columns": [
          "title",
          "contact_id",
          "amount",
          "stage_id",
          "deadline"
        ]
      },
      {
        "key": "entregas_da_semana",
        "record_type": "deals.deal",
        "name": "Entregas dos próximos 7 dias",
        "view_type": "table",
        "filter": {
          "op": "and",
          "conditions": [
            {
              "field": "status",
              "operator": "eq",
              "value": "won"
            },
            {
              "field": "deadline",
              "operator": "within_next_days",
              "value": 7
            }
          ]
        },
        "sort": [
          {
            "field": "deadline",
            "direction": "asc"
          }
        ],
        "columns": [
          "title",
          "contact_id",
          "deadline",
          "amount"
        ]
      },
      {
        "key": "projetos_fechados_no_mes",
        "record_type": "deals.deal",
        "name": "Fechados este mês",
        "view_type": "table",
        "filter": {
          "op": "and",
          "conditions": [
            {
              "field": "status",
              "operator": "eq",
              "value": "won"
            },
            {
              "field": "closed_at",
              "operator": "this_month"
            }
          ]
        },
        "sort": [
          {
            "field": "closed_at",
            "direction": "desc"
          }
        ],
        "columns": [
          "title",
          "contact_id",
          "amount",
          "payment_terms",
          "deadline"
        ]
      }
    ],
    "dashboard": {
      "widgets": [
        {
          "key": "pending_center",
          "size": "large"
        },
        {
          "key": "sales_indicators",
          "size": "medium"
        },
        {
          "key": "deals_by_stage",
          "size": "medium",
          "settings": {
            "pipeline": "projetos"
          }
        },
        {
          "key": "recent_activity",
          "size": "medium"
        }
      ],
      "period": "month"
    },
    "automations": [
      {
        "key": "follow_up_semanal",
        "name": "Follow-up semanal de orçamentos em aberto",
        "description": "Toda segunda-feira às 9h cria uma tarefa de acompanhamento para cada orçamento em aberto",
        "record_type": "deals.deal",
        "trigger": {
          "type": "time.schedule",
          "cron": "0 0 9 * * Mon",
          "filter": {
            "field": "status",
            "operator": "eq",
            "value": "open"
          }
        },
        "definition": {
          "start": "tarefa",
          "steps": [
            {
              "id": "tarefa",
              "type": "action",
              "action": "create_task",
              "config": {
                "title": "Fazer follow-up do orçamento",
                "due_in": "1d",
                "activity_type": "follow_up",
                "assignee": {
                  "type": "record_owner"
                },
                "priority": "normal"
              }
            }
          ]
        }
      }
    ]
  }
}
