{
  "format": "aphel-config",
  "format_version": 1,
  "min_aphel_version": "0.1.0",
  "name": "Real Estate",
  "description": "For real estate agencies and agents: sales and rental workflow, property details, rental fields that only appear when the deal is a rental, showings, inspections and client profile tags.",
  "author": "Aphel",
  "locale": "en",
  "sections": {
    "fields": [
      {
        "record_type": "deals.deal",
        "key": "business_type",
        "label": "Deal type",
        "type": "select",
        "options": [
          {
            "value": "sale",
            "label": "Sale",
            "color": "#1f6feb"
          },
          {
            "value": "rental",
            "label": "Rental",
            "color": "#1a7f37"
          }
        ]
      },
      {
        "record_type": "deals.deal",
        "key": "property_type",
        "label": "Property type",
        "type": "select",
        "options": [
          {
            "value": "apartment",
            "label": "Apartment",
            "color": "#1f6feb"
          },
          {
            "value": "house",
            "label": "House",
            "color": "#1a7f37"
          },
          {
            "value": "condo_house",
            "label": "House in gated community",
            "color": "#0f766e"
          },
          {
            "value": "land",
            "label": "Land",
            "color": "#bf8700"
          },
          {
            "value": "commercial",
            "label": "Commercial",
            "color": "#8250df"
          },
          {
            "value": "rural",
            "label": "Rural",
            "color": "#4d7c0f"
          }
        ]
      },
      {
        "record_type": "deals.deal",
        "key": "property_code",
        "label": "Property ID",
        "type": "text",
        "searchable": true
      },
      {
        "record_type": "deals.deal",
        "key": "neighborhood",
        "label": "Neighborhood",
        "type": "text"
      },
      {
        "record_type": "deals.deal",
        "key": "payment_method",
        "label": "Payment method",
        "type": "select",
        "options": [
          {
            "value": "cash",
            "label": "Cash",
            "color": "#1a7f37"
          },
          {
            "value": "financing",
            "label": "Mortgage",
            "color": "#1f6feb"
          },
          {
            "value": "fgts",
            "label": "Mortgage with severance fund (FGTS)",
            "color": "#0f766e"
          },
          {
            "value": "consortium",
            "label": "Purchase pool (consórcio)",
            "color": "#8250df"
          },
          {
            "value": "exchange",
            "label": "Property exchange",
            "color": "#d1631a"
          }
        ]
      },
      {
        "record_type": "deals.deal",
        "key": "financing_approved",
        "label": "Financing approved",
        "type": "checkbox"
      },
      {
        "record_type": "deals.deal",
        "key": "rent_amount",
        "label": "Monthly rent",
        "type": "currency"
      },
      {
        "record_type": "deals.deal",
        "key": "condo_fee",
        "label": "HOA fees + property tax (monthly)",
        "type": "currency"
      },
      {
        "record_type": "deals.deal",
        "key": "rental_guarantee",
        "label": "Lease guarantee",
        "type": "select",
        "options": [
          {
            "value": "guarantor",
            "label": "Guarantor",
            "color": "#1f6feb"
          },
          {
            "value": "bail_insurance",
            "label": "Rent guarantee insurance",
            "color": "#1a7f37"
          },
          {
            "value": "deposit",
            "label": "Security deposit",
            "color": "#bf8700"
          },
          {
            "value": "capitalization",
            "label": "Savings bond (título de capitalização)",
            "color": "#8250df"
          },
          {
            "value": "none",
            "label": "No guarantee",
            "color": "#6e7781"
          }
        ]
      },
      {
        "record_type": "deals.deal",
        "key": "contract_months",
        "label": "Lease term (months)",
        "type": "number",
        "config": {
          "min": 1,
          "decimals": 0
        }
      },
      {
        "record_type": "deals.deal",
        "key": "move_in_date",
        "label": "Move-in date",
        "type": "date"
      },
      {
        "record_type": "people.person",
        "key": "client_profile",
        "label": "Client profile",
        "type": "select",
        "options": [
          {
            "value": "buyer",
            "label": "Buyer",
            "color": "#1f6feb"
          },
          {
            "value": "tenant",
            "label": "Tenant",
            "color": "#1a7f37"
          },
          {
            "value": "owner",
            "label": "Owner",
            "color": "#8250df"
          }
        ]
      },
      {
        "record_type": "people.person",
        "key": "max_budget",
        "label": "Maximum budget",
        "type": "currency"
      },
      {
        "record_type": "people.person",
        "key": "desired_neighborhoods",
        "label": "Preferred neighborhoods",
        "type": "text"
      },
      {
        "record_type": "people.person",
        "key": "bedrooms",
        "label": "Desired bedrooms",
        "type": "number",
        "config": {
          "min": 0,
          "decimals": 0
        }
      }
    ],
    "workflow": [
      {
        "key": "venda",
        "name": "Sales",
        "default": true,
        "stages": [
          {
            "key": "prospeccao",
            "name": "Inquiry",
            "kind": "open",
            "probability": 10
          },
          {
            "key": "qualificacao",
            "name": "Showing",
            "kind": "open",
            "probability": 25
          },
          {
            "key": "proposta",
            "name": "Offer",
            "kind": "open",
            "probability": 50,
            "entry_required_fields": [
              "amount"
            ]
          },
          {
            "key": "negociacao",
            "name": "Negotiation",
            "kind": "open",
            "probability": 70
          },
          {
            "key": "documentacao",
            "name": "Paperwork and financing",
            "kind": "open",
            "probability": 90,
            "entry_required_fields": [
              "payment_method"
            ]
          },
          {
            "key": "ganho",
            "name": "Sold",
            "kind": "won",
            "probability": 100
          },
          {
            "key": "perdido",
            "name": "Lost",
            "kind": "lost",
            "probability": 0
          }
        ]
      },
      {
        "key": "locacao",
        "name": "Rentals",
        "stages": [
          {
            "key": "atendimento",
            "name": "Inquiry",
            "kind": "open",
            "probability": 10
          },
          {
            "key": "visita",
            "name": "Showing",
            "kind": "open",
            "probability": 30
          },
          {
            "key": "analise_cadastral",
            "name": "Tenant screening",
            "kind": "open",
            "probability": 60,
            "entry_required_fields": [
              "rent_amount",
              "rental_guarantee"
            ]
          },
          {
            "key": "contrato",
            "name": "Lease signing",
            "kind": "open",
            "probability": 85,
            "entry_required_fields": [
              "contract_months",
              "move_in_date"
            ]
          },
          {
            "key": "alugado",
            "name": "Leased",
            "kind": "won",
            "probability": 100
          },
          {
            "key": "perdido",
            "name": "Lost",
            "kind": "lost",
            "probability": 0
          }
        ]
      }
    ],
    "lost_reasons": [
      {
        "key": "preco",
        "name": "Price"
      },
      {
        "key": "escolheu_um_concorrente",
        "name": "Chose a competitor"
      },
      {
        "key": "sem_orcamento",
        "name": "No budget"
      },
      {
        "key": "sem_resposta",
        "name": "No response"
      },
      {
        "key": "momento_inadequado",
        "name": "Bad timing"
      },
      {
        "key": "outro",
        "name": "Other"
      },
      {
        "key": "credito_reprovado",
        "name": "Credit or application declined"
      },
      {
        "key": "imovel_indisponivel",
        "name": "Property no longer available"
      },
      {
        "key": "desistiu_do_imovel",
        "name": "Lost interest after showing"
      }
    ],
    "task_types": [
      {
        "key": "visit",
        "name": "Showing",
        "icon": "map-pin",
        "color": "#bf8700"
      },
      {
        "key": "inspection",
        "name": "Property inspection",
        "icon": "flag",
        "color": "#d1631a"
      },
      {
        "key": "contract_signing",
        "name": "Contract signing",
        "icon": "handshake",
        "color": "#1a7f37"
      }
    ],
    "tags": [
      {
        "key": "investidor",
        "name": "Investor",
        "color": "#f59e0b",
        "record_types": [
          "people.person",
          "deals.deal"
        ]
      },
      {
        "key": "primeira_compra",
        "name": "First-time buyer",
        "color": "#16a34a",
        "record_types": [
          "people.person",
          "deals.deal"
        ]
      },
      {
        "key": "permuta",
        "name": "Open to property exchange",
        "color": "#8250df",
        "record_types": [
          "people.person",
          "deals.deal"
        ]
      }
    ],
    "layouts": [
      {
        "record_type": "deals.deal",
        "context": "create",
        "layout": {
          "tabs": [
            {
              "id": "main",
              "label": "Details",
              "sections": [
                {
                  "id": "deal",
                  "label": "Deal",
                  "columns": [
                    {
                      "fields": [
                        {
                          "key": "title"
                        },
                        {
                          "key": "business_type"
                        },
                        {
                          "key": "contact_id"
                        }
                      ]
                    },
                    {
                      "fields": [
                        {
                          "key": "owner_id"
                        },
                        {
                          "key": "expected_close_date"
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "property",
                  "label": "Property",
                  "columns": [
                    {
                      "fields": [
                        {
                          "key": "property_type"
                        },
                        {
                          "key": "property_code"
                        }
                      ]
                    },
                    {
                      "fields": [
                        {
                          "key": "neighborhood"
                        },
                        {
                          "key": "amount"
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "sale",
                  "label": "Sale details",
                  "columns": [
                    {
                      "fields": [
                        {
                          "key": "payment_method",
                          "visible_when": {
                            "field": "business_type",
                            "operator": "eq",
                            "value": "sale"
                          }
                        }
                      ]
                    },
                    {
                      "fields": [
                        {
                          "key": "financing_approved",
                          "visible_when": {
                            "field": "business_type",
                            "operator": "eq",
                            "value": "sale"
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "rental",
                  "label": "Rental details",
                  "columns": [
                    {
                      "fields": [
                        {
                          "key": "rent_amount",
                          "visible_when": {
                            "field": "business_type",
                            "operator": "eq",
                            "value": "rental"
                          },
                          "required_when": {
                            "field": "business_type",
                            "operator": "eq",
                            "value": "rental"
                          }
                        },
                        {
                          "key": "condo_fee",
                          "visible_when": {
                            "field": "business_type",
                            "operator": "eq",
                            "value": "rental"
                          }
                        },
                        {
                          "key": "rental_guarantee",
                          "visible_when": {
                            "field": "business_type",
                            "operator": "eq",
                            "value": "rental"
                          }
                        }
                      ]
                    },
                    {
                      "fields": [
                        {
                          "key": "contract_months",
                          "visible_when": {
                            "field": "business_type",
                            "operator": "eq",
                            "value": "rental"
                          }
                        },
                        {
                          "key": "move_in_date",
                          "visible_when": {
                            "field": "business_type",
                            "operator": "eq",
                            "value": "rental"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
