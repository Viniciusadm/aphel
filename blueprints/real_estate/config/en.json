          "settings": {
            "pipeline": "venda"
          }
        },
        {
          "key": "deals_by_stage",
          "size": "medium",
          "settings": {
            "pipeline": "locacao"
          }
        },
        {
          "key": "pending_center",
          "size": "medium"
        },
        {
          "key": "recent_activity",
          "size": "medium"
        }
      ],
      "period": "month"
    }
