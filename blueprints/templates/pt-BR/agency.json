{
  "format": "aphel-config",
  "format_version": 1,
  "min_aphel_version": "0.1.0",
  "name": "Agência",
  "description": "Para agências de marketing, design e desenvolvimento: novos projetos e renovações de contrato em funis separados, com escopo, serviços contratados, fee mensal e atividades de briefing e apresentação.",
  "author": "Aphel",
  "locale": "pt-BR",
  "sections": {
    "fields": [
      {
        "record_type": "deal",
        "key": "services",
        "label": "Serviços",
        "type": "multi_select",
        "options": [
          {
            "value": "website",
            "label": "Site",
            "color": "#1f6feb"
          },
          {
            "value": "branding",
            "label": "Identidade visual",
            "color": "#8250df"
          },
          {
            "value": "social_media",
            "label": "Redes sociais",
            "color": "#bf3989"
          },
          {
            "value": "paid_media",
            "label": "Mídia paga",
            "color": "#d1631a"
          },
          {
            "value": "seo",
            "label": "SEO",
            "color": "#1a7f37"
          },
          {
            "value": "content",
            "label": "Conteúdo",
            "color": "#0f766e"
          },
          {
            "value": "video",
            "label": "Vídeo",
            "color": "#cf222e"
          },
          {
            "value": "software",
            "label": "Desenvolvimento de sistema",
            "color": "#4f46e5"
          }
        ]
      },
      {
        "record_type": "deal",
        "key": "billing_model",
        "label": "Modelo de contratação",
        "type": "select",
        "options": [
          {
            "value": "project",
            "label": "Projeto fechado",
            "color": "#1f6feb"
          },
          {
            "value": "retainer",
            "label": "Fee mensal",
            "color": "#1a7f37"
          },
          {
            "value": "hourly",
            "label": "Banco de horas",
            "color": "#bf8700"
          }
        ]
      },
      {
        "record_type": "deal",
        "key": "monthly_fee",
        "label": "Fee mensal",
        "type": "currency",
        "config": {
          "currency": "BRL"
        }
      },
      {
        "record_type": "deal",
        "key": "contract_months",
        "label": "Duração do contrato (meses)",
        "type": "number",
        "config": {
          "min": 1,
          "decimals": 0
        }
      },
      {
        "record_type": "deal",
        "key": "scope",
        "label": "Escopo",
        "type": "long_text"
      },
      {
        "record_type": "deal",
        "key": "briefing_url",
        "label": "Link do briefing",
        "type": "url"
      },
      {
        "record_type": "deal",
        "key": "delivery_date",
        "label": "Prazo de entrega",
        "type": "date"
      },
      {
        "record_type": "deal",
        "key": "contract_end_date",
        "label": "Fim do contrato",
        "type": "date"
      },
      {
        "record_type": "company",
        "key": "client_since",
        "label": "Cliente desde",
        "type": "date"
      },
      {
        "record_type": "company",
        "key": "account_manager",
        "label": "Atendimento responsável",
        "type": "user"
      },
      {
        "record_type": "company",
        "key": "channels",
        "label": "Canais ativos",
        "type": "multi_select",
        "options": [
          {
            "value": "instagram",
            "label": "Instagram",
            "color": "#bf3989"
          },
          {
            "value": "facebook",
            "label": "Facebook",
            "color": "#1f6feb"
          },
          {
            "value": "linkedin",
            "label": "LinkedIn",
            "color": "#4f46e5"
          },
          {
            "value": "tiktok",
            "label": "TikTok",
            "color": "#6e7781"
          },
          {
            "value": "youtube",
            "label": "YouTube",
            "color": "#cf222e"
          },
          {
            "value": "google",
            "label": "Google",
            "color": "#1a7f37"
          }
        ]
      }
    ],
    "workflow": [
      {
        "key": "novos_projetos",
        "name": "Novos projetos",
        "default": true,
        "stages": [
          {
            "key": "prospeccao",
            "name": "Contato inicial",
            "kind": "open",
            "probability": 10
          },
          {
            "key": "qualificacao",
            "name": "Briefing",
            "kind": "open",
            "probability": 25,
            "exit_required_fields": [
              "services"
            ]
          },
          {
            "key": "proposta",
            "name": "Proposta enviada",
            "kind": "open",
            "probability": 50,
            "entry_required_fields": [
              "amount",
              "scope"
            ]
          },
          {
            "key": "negociacao",
            "name": "Negociação",
            "kind": "open",
            "probability": 75
          },
          {
            "key": "ganho",
            "name": "Fechado",
            "kind": "won",
            "probability": 100
          },
          {
            "key": "perdido",
            "name": "Perdido",
            "kind": "lost",
            "probability": 0
          }
        ]
      },
      {
        "key": "renovacoes",
        "name": "Renovações",
        "stages": [
          {
            "key": "contrato_a_vencer",
            "name": "Contrato a vencer",
            "kind": "open",
            "probability": 50,
            "exit_required_fields": [
              "contract_end_date"
            ]
          },
          {
            "key": "apresentacao_resultados",
            "name": "Apresentação de resultados",
            "kind": "open",
            "probability": 65
          },
          {
            "key": "proposta_renovacao",
            "name": "Proposta de renovação",
            "kind": "open",
            "probability": 80,
            "entry_required_fields": [
              "amount"
            ]
          },
          {
            "key": "renovado",
            "name": "Renovado",
            "kind": "won",
            "probability": 100
          },
          {
            "key": "nao_renovado",
            "name": "Não renovado",
            "kind": "lost",
            "probability": 0
          }
        ]
      }
    ],
    "lost_reasons": [
      {
        "key": "preco",
        "name": "Preço"
      },
      {
        "key": "escolheu_um_concorrente",
        "name": "Escolheu um concorrente"
      },
      {
        "key": "sem_orcamento",
