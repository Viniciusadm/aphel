      },
      {
        "key": "prazo_inviavel",
        "name": "Prazo inviável"
      },
      {
        "key": "levou_para_dentro_de_casa",
        "name": "Cliente internalizou o serviço"
      }
    ],
    "activity_types": [
      {
        "key": "briefing",
        "name": "Briefing",
        "icon": "file-text",
        "color": "#0f766e"
      },
      {
        "key": "presentation",
        "name": "Apresentação",
        "icon": "presentation",
        "color": "#8250df"
      },
      {
        "key": "delivery",
        "name": "Entrega",
        "icon": "send",
        "color": "#1a7f37"
      }
    ],
    "layouts": [
