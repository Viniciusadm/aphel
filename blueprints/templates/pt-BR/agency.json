          "key": "sales_indicators",
          "size": "large"
        },
        {
          "key": "deals_by_stage",
          "size": "medium",
          "settings": {
            "pipeline": "novos_projetos"
          }
        },
        {
          "key": "deals_by_stage",
          "size": "medium",
          "settings": {
            "pipeline": "renovacoes"
          }
        },
