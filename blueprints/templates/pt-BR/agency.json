                    {
                      "fields": [
                        {
                          "key": "amount"
                        },
                        {
                          "key": "expected_close_date"
                        },
                        {
                          "key": "owner_id"
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "scope",
                  "label": "Escopo e contratação",
                  "columns": [
                    {
                      "fields": [
                        {
                          "key": "services"
                        },
                        {
                          "key": "billing_model"
                        },
                        {
                          "key": "monthly_fee",
                          "visible_when": {
                            "field": "billing_model",
                            "operator": "eq",
                            "value": "retainer"
                          },
                          "required_when": {
                            "field": "billing_model",
                            "operator": "eq",
                            "value": "retainer"
                          }
                        },
                        {
                          "key": "contract_months",
                          "visible_when": {
                            "field": "billing_model",
                            "operator": "eq",
                            "value": "retainer"
                          }
                        }
                      ]
                    },
                    {
                      "fields": [
                        {
                          "key": "delivery_date"
                        },
                        {
                          "key": "contract_end_date"
                        },
                        {
                          "key": "briefing_url"
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "details",
                  "label": "Detalhamento",
                  "columns": [
                    {
                      "fields": [
                        {
                          "key": "scope"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
